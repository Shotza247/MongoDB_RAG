# Runtime
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8765
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=RAG_with_MongoDB
MONGODB_COLLECTION=profile_chunks
VECTOR_INDEX_NAME=profile_vector_index
VECTOR_FIELD=embedding
VECTOR_DIMENSIONS=1024
VECTOR_NUM_CANDIDATES=150

# Embeddings: voyage | openai | hashing
EMBEDDING_PROVIDER=voyage
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_API_KEY=replace-with-your-atlas-model-api-key
VOYAGE_MODEL=voyage-context-4
RERANK_PROVIDER=voyage
VOYAGE_RERANK_MODEL=rerank-2.5
RERANK_TIMEOUT_SECONDS=90
OPENAI_API_KEY=[your-api-key-here-please]
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generative chat model for LangChain/LangGraph (Voyage is not a chat provider)
# gpt-5.4-mini is not accessible for this API project; use an enabled chat model.
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-5.5
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_TEMPERATURE=0
CHAT_MAX_TOKENS=700
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_RETRIES=2
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
